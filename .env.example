# 🛠 Переменные окружения для LED Warehouse Bot
#
# 💡 Этот файл — шаблон. Настоящий .env НЕ должен коммититься в репозиторий!
#
# Скопируйте этот файл в .env и укажите реальные значения

# 🔑 Токен Telegram-бота (получите у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 🗃️ Путь к файлу базы данных SQLite
# По умолчанию создаётся в корне проекта
DB_FILE=warehouse.db

# 📝 Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 🖼️ Папка для сохранения фото модулей
PHOTOS_DIR=photos/modules

# 📊 Папка для экспорта отчётов
REPORTS_DIR=reports

# 🌐 Хост и порт для health-check сервера (если используется)
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080